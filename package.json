{
  "name": "hoa-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HOA-owned owner portal: Google/email-link sign-in, bills, documents, messages, board view. Specialist services (Stripe, Lob, books) sit behind it.",
  "scripts": {
    "dev": "vite web",
    "dev:demo": "VITE_DATA_MODE=demo vite web",
    "build": "tsc -p web/tsconfig.json --noEmit && vite build web",
    "build:demo": "VITE_DATA_MODE=demo vite build web --outDir ../dist-demo",
    "test": "vitest run",
    "test:db": "bash supabase/tests/run.sh",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check": "npm run test && npm run test:db && npm run build && npm run check:secrets"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
